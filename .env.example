# Optional. The app runs without a .env file: it keeps its data in ~/featherstone-data
# and makes its own keys there on first run. Your OpenAI API key (optional) is set
# in the app under Settings → Connections.
#
# Uncomment a line only to override a default.

# DATABASE_URI=sqlite:////absolute/path/to/scripture.db
# FEATHERSTONE_DATA_DIR=/absolute/path/to/data-folder
# SECRET_KEY=...                  # default: made automatically in the data folder
# OPENAI_API_KEY=sk-...           # used if none is saved in Settings
# VAPID_SUBJECT=mailto:you@example.com   # contact sent to push services; a placeholder works
